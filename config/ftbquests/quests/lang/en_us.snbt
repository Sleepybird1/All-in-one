  "quest.4B2C38F6A6067EFC.quest_desc": [
    "Build the canonical TFMG generator and motor and connect rotation to the first local FE bus.",
    "This is a non-consuming observation task: keep the hardware in your factory; the recipe and machine chain remain the only progression authority."
  ],
