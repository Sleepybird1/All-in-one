  "quest.054D724C340A94CA.title": "Extended Digital Manufacturing",
  "quest.054D724C340A94CA.quest_subtitle": "Add ExtendedAE batch assembly, advanced reactions, and the first MEGA-scale cell component.",
  "quest.054D724C340A94CA.quest_desc": [
    "Add ExtendedAE batch assembly, advanced reactions, and the first MEGA-scale cell component.",
