  "quest.61F970DC10825CB2.title": "Bulk Matter Reserve",
  "quest.61F970DC10825CB2.quest_subtitle": "Nine renewable material streams, compressed to their absolute limit.",
  "quest.61F970DC10825CB2.quest_desc": [
    "Produce one 9x compressed block from each renewable bulk-material line.",
    "Each 9x block represents 387,420,489 base blocks; all nine lines together represent 3,486,784,401 blocks of manufactured matter.",
    "Keep all nine blocks: the final 3×3 Black Hole recipe consumes them."
  ],
  "quest.3373AEB6F841A026.title": "Industrial Reserve Core",
  "quest.3373AEB6F841A026.quest_subtitle": "Physically concentrate the chemical, fuel, polymer, and actinide reserves.",
  "quest.3373AEB6F841A026.quest_desc": [
    "Run a 512-loop Create sequenced assembly to manufacture one Industrial Reserve Core.",
    "The assembly consumes 1,024,000 mB TFMG Sulfuric Acid, 5,120,000 mB TFMG Diesel, 4,096 HDPE Pellets, and 512 Plutonium Pellets.",
    "TFMG Sulfuric Acid is the only acid synthesis route; HDPE and Plutonium force the corresponding Mekanism chemical-gas production chains."
  ],
  "quest.4B66DE417E679AE6.title": "Black Hole",
  "quest.4B66DE417E679AE6.quest_subtitle": "Collapse the nine maximum-density bulk materials into one capstone component.",
  "quest.4B66DE417E679AE6.quest_desc": [
    "Craft the Black Hole in a normal 3×3 crafting grid.",
    "Its nine ingredients are exactly the nine 9x compressed blocks from Bulk Matter Reserve.",
    "This is a component of the final artifact, not the end of the questline."
  ],
  "quest.00C5B9DFDCC5F502.title": "Industrial Star",
  "quest.00C5B9DFDCC5F502.quest_subtitle": "Complete the base pack's ultimate factory artifact.",
  "quest.00C5B9DFDCC5F502.quest_desc": [
    "Mechanically craft the Black Hole, Industrial Reserve Core, and all three manufactured Allthemodium alloy families in a 5×5 grid.",
    "The Industrial Star is the base-pack capstone and the future handoff into orbital and space-travel expansions."
  ]
}
